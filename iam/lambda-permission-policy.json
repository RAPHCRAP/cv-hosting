{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTenantObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3063/tenants/*"
    },
    {
      "Sid": "WriteTenantUploads",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::cv-23l-3063/tenants/*/site/*"
    }
  ]
}
